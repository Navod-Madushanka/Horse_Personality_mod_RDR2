<Project Sdk="Microsoft.NET.Sdk">
  <!--
    All mod logic lives here. No reference to the game or to ScriptHookRDR2DotNet, so it runs in unit tests.
    The Game and DevTools projects compile these sources in directly, so the mod still ships as one DLL.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>HorsePersonalities.Core</RootNamespace>
    <AssemblyName>HorsePersonalities.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HorsePersonalities.Tests" />
  </ItemGroup>
</Project>
